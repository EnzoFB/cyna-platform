# =====================================================================
# PRODUCTION environment — copy to `.env.prod` and fill EVERY value.
# `.env.prod` is git-ignored. Never commit real secrets.
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# =====================================================================

# === Profile ===
SPRING_PROFILES_ACTIVE=prod

# === Database (Postgres container) ===
DB_NAME=cyna
DB_USERNAME=cyna
# Strong, unique password — generate with: openssl rand -base64 24
DB_PASSWORD=CHANGE_ME_strong_db_password
# DB_HOST / DB_PORT are set by docker-compose.prod.yml (postgres:5432).

# === JWT — REQUIRED, no default (backend fails to start if unset) ===
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_min_256_bits_base64
JWT_ACCESS_EXPIRATION_HOURS=1
JWT_REFRESH_EXPIRATION_HOURS=24

# === Login OTP — REQUIRED in prod, no default ===
# Server-side HMAC pepper (>=16 bytes). Generate: openssl rand -base64 32
OTP_HASH_PEPPER=CHANGE_ME_min_16_bytes
OTP_LOGIN_CODE_LENGTH=6
OTP_LOGIN_EXPIRATION_MINUTES=5
OTP_LOGIN_EMAIL_THROTTLE_MAX=3
OTP_LOGIN_EMAIL_THROTTLE_WINDOW_SECONDS=900

# === CORS — REQUIRED in prod, no localhost fallback ===
# Exact front-end origin(s), comma-separated, no trailing slash.
CORS_ALLOWED_ORIGINS=https://app.cyna.com,https://admin.cyna.com

# === Stripe (LIVE keys) ===
# Secret + webhook secret are server-only. The publishable key is also used
# as a Docker build-arg to bake it into the front-end bundle.
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME
# From the live webhook endpoint (https://dashboard.stripe.com/webhooks):
#   endpoint URL = https://app.cyna.com/api/v1/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
# Enable only once Stripe Tax is active with at least one tax registration.
STRIPE_TAX_ENABLED=true
STRIPE_TAX_CODE=txcd_10103000

# === Brevo (transactional email) ===
BREVO_API_KEY=CHANGE_ME
BREVO_SENDER_EMAIL=no-reply@cyna.com
BREVO_SENDER_NAME=Cyna
# Public base URL used in email links (password reset, order confirmation…).
APP_PUBLIC_URL=https://app.cyna.com
# Recipient of contact-form submissions.
CONTACT_TO_EMAIL=contact@cyna.com

# === Trusted device (optional) ===
AUTH_TRUSTED_DEVICE_EXPIRATION_DAYS=30
