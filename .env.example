# Active Spring profile
SPRING_PROFILES_ACTIVE=local

# Database connection used by backend application.yml placeholders
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cyna
DB_USERNAME=cyna
DB_PASSWORD=cyna_dev_password

# Optional explicit datasource override (used by Spring and Gradle Flyway fallback)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cyna
# SPRING_DATASOURCE_USERNAME=cyna
# SPRING_DATASOURCE_PASSWORD=cyna_dev_password

# JWT settings
JWT_SECRET=change-this-local-secret-key-min-256-bits
JWT_ACCESS_EXPIRATION_HOURS=1
JWT_REFRESH_EXPIRATION_HOURS=24

# Backend port
SERVER_PORT=8080
