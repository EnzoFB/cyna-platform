{
  "schemaVersion": 36,
  "title": "Incident Search",
  "uid": "cyna-incident-search",
  "tags": ["cyna", "incident"],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "app",
        "type": "custom",
        "query": "cyna-backend,cyna-frontend",
        "current": {
          "text": "cyna-backend",
          "value": "cyna-backend"
        },
        "includeAll": true,
        "allValue": "cyna-.*",
        "multi": false
      },
      {
        "name": "level",
        "type": "custom",
        "query": "INFO,WARN,ERROR,DEBUG",
        "current": {
          "text": "ERROR",
          "value": "ERROR"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": false
      },
      {
        "name": "traceId",
        "type": "textbox",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Logs Explorer",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "{app=\"$app\",level=\"$level\"} |= \"$traceId\"",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          }
        }
      ],
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      }
    }
  ]
}