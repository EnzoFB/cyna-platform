# === Database ===
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cyna
SPRING_DATASOURCE_USERNAME=cyna
SPRING_DATASOURCE_PASSWORD=cyna_dev_password

# === JWT ===
