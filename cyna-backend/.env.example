# === Database ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cyna
DB_USERNAME=cyna
DB_PASSWORD=cyna_dev_password

# === JWT ===
# REQUIRED — no committed default. The backend fails to start without it.
# Generate a fresh secret (≥256 bits) per environment, e.g.:
#   openssl rand -base64 48
# Rotating this value invalidates every issued access token (users keep
# refresh tokens, so they just see one extra /auth/refresh round-trip).
JWT_SECRET=
JWT_ACCESS_EXPIRATION_HOURS=1
JWT_REFRESH_EXPIRATION_HOURS=24
OTP_LOGIN_CODE_LENGTH=6
OTP_LOGIN_EXPIRATION_MINUTES=5
# Anti mailbox-bombing: max OTP mails per account per window (default: 3 per 15 min)
OTP_LOGIN_EMAIL_THROTTLE_MAX=3
OTP_LOGIN_EMAIL_THROTTLE_WINDOW_SECONDS=900
# Server-side pepper for HMAC-ing the login OTP (defence against DB dump).
# MUST be ≥16 bytes and overridden per environment — leave the dev default
# in application.yml for local boots; production should set this here.
OTP_HASH_PEPPER=cyna-dev-otp-pepper-must-be-overridden-in-prod

# === Stripe ===
# Récupérer les clés sur https://dashboard.stripe.com/apikeys
# Le webhook secret est obtenu via : stripe listen --forward-to localhost:8080/api/v1/payments/webhook
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX
# Stripe Tax — laisser à false tant que Tax n'est pas activé dans le dashboard
# Stripe AVEC au moins une immatriculation fiscale (sinon la création
# d'abonnement échoue). Code de taxe produit par défaut : SaaS.
STRIPE_TAX_ENABLED=false
STRIPE_TAX_CODE=txcd_10103000

# === Brevo (transactional email) ===
# Generate / rotate at https://app.brevo.com/settings/keys/api
# Empty value disables outbound mail (errors are logged, app keeps running).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no.reply.cyna.app@gmail.com
BREVO_SENDER_NAME=Cyna
# Public URL used in email links (password reset, order confirmation, etc.)
APP_PUBLIC_URL=http://localhost:4200
# Recipient address for contact form submissions
CONTACT_TO_EMAIL=your-email@example.com

# === Application ===
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
